<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Plutón WebAR</title>

    <script type="module"
        src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js">
    </script>

</head>

<body>

    <h1>Explora</h1>

    <p>
        Museo virtual de telescopios espaciales.
    </p>

    <model-viewer
    src="telescopios/Chandra.glb"
        alt="Modelo 3D de Plutón"
        camera-controls
        auto-rotate
        ar
        ar-modes="scene-viewer webxr quick-look"
        style="width: 100%; height: 500px;">
</model-viewer>

</body>

</html>
